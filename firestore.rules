rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function only(keys) { return request.resource.data.keys().hasOnly(keys); }
    function validTask() {
      return only(['title','description','projectId','assignedDate','startDate','deadline','priority','status','progress','subtasks','references','notes','recurrence','completedAt','createdAt','updatedAt','archived','occurrenceKey'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300
        && request.resource.data.description is string && request.resource.data.description.size() <= 20000
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 20000
        && request.resource.data.projectId is string
        && request.resource.data.assignedDate is string && request.resource.data.startDate is string && request.resource.data.deadline is string
        && request.resource.data.priority in ['low','medium','high','urgent']
        && request.resource.data.status in ['todo','progress','review','done']
        && (!('progress' in request.resource.data) || (request.resource.data.progress is int && request.resource.data.progress >= 0 && request.resource.data.progress <= 100))
        && request.resource.data.subtasks is list && request.resource.data.subtasks.size() <= 100
        && request.resource.data.references is list && request.resource.data.references.size() <= 100
        && request.resource.data.recurrence is map
        && request.resource.data.completedAt is string
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && request.resource.data.archived is bool && request.resource.data.occurrenceKey is string;
    }
    function validProject() {
      return only(['name','description','color','priority','archived','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && (!('priority' in request.resource.data) || request.resource.data.priority in ['low','medium','high','urgent'])
        && request.resource.data.archived is bool
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string;
    }
    function validTemplate() {
      return only(['name','title','description','priority','subtasks','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300
        && request.resource.data.description is string && request.resource.data.description.size() <= 20000
        && request.resource.data.priority in ['low','medium','high','urgent']
        && request.resource.data.subtasks is list && request.resource.data.subtasks.size() <= 100
        && request.resource.data.createdAt is string;
    }
    function validActivity() {
      return only(['taskId','taskTitle','action','at'])
        && request.resource.data.taskId is string && request.resource.data.taskTitle is string
        && request.resource.data.action is string && request.resource.data.at is string;
    }
    match /users/{uid} {
      allow read, write: if owner(uid);
      match /tasks/{id} { allow read: if owner(uid); allow create, update: if owner(uid) && validTask(); allow delete: if owner(uid); }
      match /projects/{id} { allow read: if owner(uid); allow create, update: if owner(uid) && validProject(); allow delete: if owner(uid); }
      match /templates/{id} { allow read, delete: if owner(uid); allow create, update: if owner(uid) && validTemplate(); }
      match /activityLogs/{id} { allow read: if owner(uid); allow create: if owner(uid) && validActivity(); allow update, delete: if false; }
    }
  }
}
